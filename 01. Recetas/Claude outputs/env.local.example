# Copia este archivo a .env.local y rellena los valores desde tu proyecto
# de Supabase (Project Settings → API). Ver README, sección "Conectar Supabase".

# Seguras de exponer al navegador (NEXT_PUBLIC_*): la clave "anon" solo
# permite lo que las políticas de Row Level Security dejan hacer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA — nunca con prefijo NEXT_PUBLIC_, nunca en el repositorio ni en el
# chat. Solo se usa una vez, en local, para ejecutar scripts/seed-supabase.js
# (salta las políticas de RLS). Bórrala de .env.local después de sembrar los
# datos, o rota la clave desde el panel de Supabase si crees que se expuso.
SUPABASE_SERVICE_ROLE_KEY=
